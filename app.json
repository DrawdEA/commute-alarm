{
  "expo": {
    "name": "LoClock",
    "slug": "commute-alarm",
    "scheme": "loclock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loclock.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "LoClock rings an alarm when you're about to reach your stop, even if your phone is locked or on silent."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.loclock.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LoClock uses your location to alert you when you're near your saved stop.",
          "locationAlwaysAndWhenInUsePermission": "Allow \"Always\" so LoClock can wake you up when you're near your stop, even with your phone locked. Your location never leaves your device.",
          "locationAlwaysPermission": "Allow \"Always\" so LoClock can wake you up when you're near your stop, even with your phone locked. Your location never leaves your device.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alarmsounds-ios/alarm_chiptune.caf",
            "./assets/alarmsounds-ios/alarm_default.caf",
            "./assets/alarmsounds-ios/alarm_dreamscape.caf",
            "./assets/alarmsounds-ios/alarm_fever_dream.caf",
            "./assets/alarmsounds-ios/alarm_lo_fi.caf",
            "./assets/alarmsounds-ios/alarm_morning_joy.caf",
            "./assets/alarmsounds-ios/alarm_physical.caf",
            "./assets/alarmsounds-ios/alarm_robotic.caf",
            "./assets/alarmsounds-ios/alarm_rush.caf",
            "./assets/alarmsounds-ios/alarm_softplucks.caf",
            "./assets/alarmsounds-ios/alarm_stardust.caf",
            "./assets/alarmsounds-ios/alarm_synapse.caf"
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3553e511-c296-48d3-84dd-870418f56c1c"
      }
    }
  }
}
